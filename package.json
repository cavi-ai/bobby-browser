{
  "name": "bobby-browser",
  "description": "Browser automation runtime with authenticated, capability-scoped control surfaces designed for agentic workflows",
  "version": "0.11.0",
  "author": "Sasan Sotoodehfar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavi-ai/bobby-browser.git"
  },
  "homepage": "https://cavi-ai.xyz/docs/bobby-browser",
  "bugs": {
    "url": "https://github.com/cavi-ai/bobby-browser/issues"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:build": "node scripts/docs/build-bobby-browser.mjs",
    "docs:verify": "node scripts/docs/verify-bobby-browser.mjs",
    "docs:test": "node --test --test-concurrency=1 scripts/docs/*.test.mjs",
    "docs:release-artifact": "node scripts/docs/release-artifact.mjs",
    "docs:release-envelope": "node scripts/docs/create-release-envelope.mjs",
    "format": "cargo fmt --all --check",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "typescript": "7.0.2"
  }
}
