{
  "name": "@cavi-ai/bobby-firefox-companion",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavi-ai/bobby-browser.git",
    "directory": "packages/firefox-companion"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/background.ts src/content.ts src/popup.ts --bundle --format=iife --platform=browser --outdir=dist && cp manifest.json dist/manifest.json && cp popup.html dist/popup.html",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
