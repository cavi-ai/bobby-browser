{
  "manifest_version": 3,
  "name": "Bobby Browser Companion",
  "version": "0.1.0",
  "description": "Isolated Firefox page observation and interaction companion",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-companion@bobby-browser.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["tabs", "activeTab", "scripting", "nativeMessaging", "storage", "webNavigation"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
