{
  "name": "@bobby-browser/sdk",
  "version": "0.2.0",
  "description": "Typed client for the authenticated Bobby Browser runtime interface",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "22.15.3"
  }
}
