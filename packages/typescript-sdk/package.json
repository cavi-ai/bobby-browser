{
  "name": "@cavi-ai/bobby-browser",
  "version": "0.9.0",
  "description": "Typed client for the authenticated Bobby Browser runtime interface",
  "license": "MIT",
  "author": "Sasan Sotoodehfar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavi-ai/bobby-browser.git",
    "directory": "packages/typescript-sdk"
  },
  "homepage": "https://cavi-ai.xyz/docs/bobby-browser",
  "bugs": {
    "url": "https://github.com/cavi-ai/bobby-browser/issues"
  },
  "keywords": [
    "browser-automation",
    "cdp",
    "mcp",
    "playwright",
    "puppeteer",
    "bobby-browser"
  ],
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
