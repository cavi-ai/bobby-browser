{
  "name": "page.goto",
  "description": "Navigate a page to a URL",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pageId": { "type": "string" },
      "url": { "type": "string", "format": "uri" },
      "waitUntil": {
        "type": "string",
        "enum": ["commit", "domcontentloaded", "interactive", "networkidle"]
      },
      "timeoutMs": { "type": "integer", "minimum": 1 }
    },
    "required": ["pageId", "url"]
  }
}
